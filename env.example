import { Router } from "express";
import { pool } from "../db/pool";
import { authenticate, authorize } from "../middleware/auth";

const router = Router();
const REPORT_ROLES = ["SUPER_ADMIN", "ICT_ADMIN", "WASTE_MANAGER", "SUPERVISOR", "MANAGEMENT"];

function dateRangeClause(alias: string, date_from?: any, date_to?: any, values: any[] = [], startIdx = 1) {
  const clauses: string[] = [];
  let i = startIdx;
  if (date_from) { clauses.push(`${alias}.scheduled_date >= $${i++}`); values.push(date_from); }
  if (date_to) { clauses.push(`${alias}.scheduled_date <= $${i++}`); values.push(date_to); }
  return { clauses, nextIdx: i };
}

// --- Collection report: scheduled / completed / missed / late / efficiency ---
router.get("/collections", authenticate, authorize(...REPORT_ROLES), async (req, res) => {
  const { date_from, date_to, zone_id, waste_type, collector_id } = req.query;
  const values: any[] = [];
  const { clauses, nextIdx } = dateRangeClause("c", date_from, date_to, values);
  let i = nextIdx;
  if (zone_id) { clauses.push(`c.zone_id = $${i++}`); values.push(zone_id); }
  if (waste_type) { clauses.push(`c.waste_type = $${i++}`); values.push(waste_type); }
  if (collector_id) { clauses.push(`c.collector_id = $${i++}`); values.push(collector_id); }
  const where = clauses.length ? `WHERE ${clauses.join(" AND ")}` : "";

  const summary = await pool.query(
    `SELECT COUNT(*)::int AS scheduled,
            COUNT(*) FILTER (WHERE status = 'COMPLETED')::int AS completed,
            COUNT(*) FILTER (WHERE status = 'MISSED')::int AS missed,
            COUNT(*) FILTER (WHERE status = 'PENDING' AND scheduled_date < CURRENT_DATE)::int AS late
     FROM collections c ${where}`,
    values
  );
  const s = summary.rows[0];
  const efficiency = s.scheduled > 0 ? Math.round((s.completed / s.scheduled) * 1000) / 10 : 0;

  const daily = await pool.query(
    `SELECT scheduled_date, COUNT(*)::int AS total,
            COUNT(*) FILTER (WHERE status = 'COMPLETED')::int AS completed,
            COUNT(*) FILTER (WHERE status = 'MISSED')::int AS missed
     FROM collections c ${where}
     GROUP BY scheduled_date ORDER BY scheduled_date`,
    values
  );

  res.json({ summary: { ...s, efficiency_pct: efficiency }, daily: daily.rows });
});

// --- Waste report: totals by type / zone / month, recycling rate ---
router.get("/waste", authenticate, authorize(...REPORT_ROLES), async (req, res) => {
  const { date_from, date_to } = req.query;
  const values: any[] = [];
  const { clauses } = dateRangeClause("c", date_from, date_to, values);
  const where = `WHERE c.status = 'COMPLETED'` + (clauses.length ? ` AND ${clauses.join(" AND ")}` : "");

  const [byType, byZone, byMonth, total] = await Promise.all([
    pool.query(`SELECT waste_type, COALESCE(SUM(quantity_collected_kg),0) AS total_kg FROM collections c ${where} GROUP BY waste_type ORDER BY total_kg DESC`, values),
    pool.query(`SELECT z.name AS zone_name, COALESCE(SUM(c.quantity_collected_kg),0) AS total_kg FROM collections c JOIN zones z ON z.id=c.zone_id ${where} GROUP BY z.name ORDER BY total_kg DESC`, values),
    pool.query(`SELECT to_char(c.scheduled_date,'YYYY-MM') AS month, COALESCE(SUM(c.quantity_collected_kg),0) AS total_kg FROM collections c ${where} GROUP BY month ORDER BY month`, values),
    pool.query(`SELECT COALESCE(SUM(quantity_collected_kg),0) AS total_kg FROM collections c ${where}`, values),
  ]);

  const recyclables = ["PLASTIC", "PAPER", "METAL", "GLASS", "E_WASTE"];
  const recyclableKg = byType.rows.filter((r) => recyclables.includes(r.waste_type)).reduce((sum, r) => sum + parseFloat(r.total_kg), 0);
  const totalKg = parseFloat(total.rows[0].total_kg) || 0;
  const recyclingRate = totalKg > 0 ? Math.round((recyclableKg / totalKg) * 1000) / 10 : 0;

  res.json({ by_type: byType.rows, by_zone: byZone.rows, by_month: byMonth.rows, total_kg: totalKg, recycling_rate_pct: recyclingRate });
});

// --- Collector report: jobs completed, punctuality, missed ---
router.get("/collectors", authenticate, authorize(...REPORT_ROLES), async (req, res) => {
  const { date_from, date_to } = req.query;
  const values: any[] = [];
  const { clauses } = dateRangeClause("c", date_from, date_to, values);
  const where = clauses.length ? `AND ${clauses.join(" AND ")}` : "";

  const result = await pool.query(
    `SELECT u.id, u.full_name,
            COUNT(c.*) FILTER (WHERE c.status = 'COMPLETED')::int AS completed,
            COUNT(c.*) FILTER (WHERE c.status = 'MISSED')::int AS missed,
            COUNT(c.*)::int AS total_assigned
     FROM users u
     LEFT JOIN collections c ON c.collector_id = u.id ${where}
     WHERE u.role = 'COLLECTOR'
     GROUP BY u.id, u.full_name
     ORDER BY completed DESC`,
    values
  );
  const withPunctuality = result.rows.map((r) => ({
    ...r,
    punctuality_pct: r.total_assigned > 0 ? Math.round((r.completed / r.total_assigned) * 1000) / 10 : null,
  }));
  res.json({ collectors: withPunctuality });
});

// --- Vehicle report: trips (proxy: assigned collections), utilization ---
router.get("/vehicles", authenticate, authorize(...REPORT_ROLES), async (req, res) => {
  const { date_from, date_to } = req.query;
  const values: any[] = [];
  const { clauses } = dateRangeClause("c", date_from, date_to, values);
  const where = clauses.length ? `AND ${clauses.join(" AND ")}` : "";

  const result = await pool.query(
    `SELECT v.id, v.registration_number, v.vehicle_type, v.mileage_km, v.trip_distance_km, v.status,
            COUNT(c.*)::int AS trips,
            COUNT(c.*) FILTER (WHERE c.status='COMPLETED')::int AS completed_trips
     FROM vehicles v
     LEFT JOIN collections c ON c.vehicle_id = v.id ${where}
     GROUP BY v.id ORDER BY trips DESC`,
    values
  );
  res.json({ vehicles: result.rows });
});

// --- Incident report: counts by category/severity, resolution time ---
router.get("/incidents", authenticate, authorize(...REPORT_ROLES), async (req, res) => {
  const [byCategory, bySeverity, resolutionTime] = await Promise.all([
    pool.query(`SELECT category, COUNT(*)::int AS count FROM incidents GROUP BY category ORDER BY count DESC`),
    pool.query(`SELECT severity, COUNT(*)::int AS count FROM incidents GROUP BY severity ORDER BY count DESC`),
    pool.query(
      `SELECT ROUND(AVG(EXTRACT(EPOCH FROM (resolved_at - created_at)) / 3600)::numeric, 1) AS avg_resolution_hours
       FROM incidents WHERE resolved_at IS NOT NULL`
    ),
  ]);
  res.json({
    by_category: byCategory.rows,
    by_severity: bySeverity.rows,
    avg_resolution_hours: resolutionTime.rows[0]?.avg_resolution_hours || null,
  });
});

// --- Environmental report: recycling, diversion, generation trend ---
router.get("/environmental", authenticate, authorize(...REPORT_ROLES), async (_req, res) => {
  const [byType, byMonth] = await Promise.all([
    pool.query(`SELECT waste_type, COALESCE(SUM(quantity_collected_kg),0) AS total_kg FROM collections WHERE status='COMPLETED' GROUP BY waste_type`),
    pool.query(`SELECT to_char(scheduled_date,'YYYY-MM') AS month, COALESCE(SUM(quantity_collected_kg),0) AS total_kg FROM collections WHERE status='COMPLETED' GROUP BY month ORDER BY month`),
  ]);
  const recyclables = ["PLASTIC", "PAPER", "METAL", "GLASS", "E_WASTE"];
  const organics = ["ORGANIC"];
  const totalKg = byType.rows.reduce((s, r) => s + parseFloat(r.total_kg), 0);
  const recycledKg = byType.rows.filter((r) => recyclables.includes(r.waste_type)).reduce((s, r) => s + parseFloat(r.total_kg), 0);
  const divertedKg = byType.rows.filter((r) => recyclables.includes(r.waste_type) || organics.includes(r.waste_type)).reduce((s, r) => s + parseFloat(r.total_kg), 0);

  res.json({
    total_kg: totalKg,
    recycling_rate_pct: totalKg > 0 ? Math.round((recycledKg / totalKg) * 1000) / 10 : 0,
    landfill_diversion_rate_pct: totalKg > 0 ? Math.round((divertedKg / totalKg) * 1000) / 10 : 0,
    generation_trend: byMonth.rows,
  });
});

// --- CSV export: generic, works for any of the report types above ---
router.get("/export.csv", authenticate, authorize(...REPORT_ROLES), async (req, res) => {
  const { type, date_from, date_to } = req.query;
  const values: any[] = [];
  const { clauses } = dateRangeClause("c", date_from, date_to, values);
  const where = clauses.length ? `WHERE ${clauses.join(" AND ")}` : "";

  let rows: any[] = [];
  let filename = "report.csv";

  if (type === "collections") {
    filename = "collections_report.csv";
    const result = await pool.query(
      `SELECT c.collection_code, z.name AS zone, c.location, c.scheduled_date, c.waste_type, c.status,
              c.quantity_collected_kg, u.full_name AS collector
       FROM collections c LEFT JOIN zones z ON z.id=c.zone_id LEFT JOIN users u ON u.id=c.collector_id
       ${where} ORDER BY c.scheduled_date DESC`,
      values
    );
    rows = result.rows;
  } else if (type === "waste") {
    filename = "waste_report.csv";
    const result = await pool.query(
      `SELECT waste_type, COALESCE(SUM(quantity_collected_kg),0) AS total_kg, COUNT(*)::int AS collections
       FROM collections c WHERE status='COMPLETED' ${clauses.length ? "AND " + clauses.join(" AND ") : ""}
       GROUP BY waste_type ORDER BY total_kg DESC`,
      values
    );
    rows = result.rows;
  } else if (type === "incidents") {
    filename = "incidents_report.csv";
    const result = await pool.query(
      `SELECT ticket_number, category, severity, status, location, created_at, resolved_at FROM incidents ORDER BY created_at DESC`
    );
    rows = result.rows;
  } else if (type === "collectors") {
    filename = "collectors_report.csv";
    const result = await pool.query(
      `SELECT u.full_name AS collector,
              COUNT(c.*) FILTER (WHERE c.status = 'COMPLETED')::int AS completed,
              COUNT(c.*) FILTER (WHERE c.status = 'MISSED')::int AS missed,
              COUNT(c.*)::int AS total_assigned
       FROM users u LEFT JOIN collections c ON c.collector_id = u.id ${clauses.length ? "AND " + clauses.join(" AND ") : ""}
       WHERE u.role = 'COLLECTOR' GROUP BY u.full_name ORDER BY completed DESC`,
      values
    );
    rows = result.rows;
  } else if (type === "vehicles") {
    filename = "vehicles_report.csv";
    const result = await pool.query(
      `SELECT v.registration_number, v.vehicle_type, v.status, v.mileage_km, v.trip_distance_km,
              COUNT(c.*)::int AS trips, COUNT(c.*) FILTER (WHERE c.status='COMPLETED')::int AS completed_trips
       FROM vehicles v LEFT JOIN collections c ON c.vehicle_id = v.id ${clauses.length ? "AND " + clauses.join(" AND ") : ""}
       GROUP BY v.id ORDER BY trips DESC`,
      values
    );
    rows = result.rows;
  } else if (type === "environmental") {
    filename = "environmental_report.csv";
    const result = await pool.query(
      `SELECT waste_type, COALESCE(SUM(quantity_collected_kg),0) AS total_kg, COUNT(*)::int AS collections
       FROM collections WHERE status='COMPLETED' GROUP BY waste_type ORDER BY total_kg DESC`
    );
    rows = result.rows;
  } else {
    return res.status(400).json({ error: "Unknown report type. Use: collections, waste, incidents, collectors, vehicles, or environmental." });
  }

  if (rows.length === 0) {
    res.setHeader("Content-Type", "text/csv");
    res.setHeader("Content-Disposition", `attachment; filename="${filename}"`);
    return res.send("No data for the selected filters.\n");
  }

  const headers = Object.keys(rows[0]);
  const csvLines = [
    headers.join(","),
    ...rows.map((r) => headers.map((h) => csvEscape(r[h])).join(",")),
  ];

  res.setHeader("Content-Type", "text/csv");
  res.setHeader("Content-Disposition", `attachment; filename="${filename}"`);
  res.send(csvLines.join("\n"));
});

function csvEscape(value: any): string {
  if (value === null || value === undefined) return "";
  const str = String(value);
  if (str.includes(",") || str.includes('"') || str.includes("\n")) {
    return `"${str.replace(/"/g, '""')}"`;
  }
  return str;
}

export default router;
